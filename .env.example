# 新顺电器仓库进销存管理系统 - 环境变量配置
#
# 本地部署模式（默认，无需 Supabase 云端）
# 直接 docker compose up -d --build 即可

# 运行端口（默认 5000）
DEPLOY_RUN_PORT=5000

# 运行环境（生产环境保持 PROD）
COZE_PROJECT_ENV=PROD

# ====== 以下为可选配置，一般无需修改 ======

# 数据库密码（默认 erp123456，如修改请同步修改）
# DB_PASSWORD=erp123456

# JWT 密钥（PostgREST 鉴权用，默认随机值即可）
# JWT_SECRET=local-dev-secret-change-me

# ====== 图片识别 OCR（大模型） ======
# 配置后可使用图片识别采购订单功能
# 从沙箱环境获取凭据，填入下方三项即可
COZE_INTEGRATION_BASE_URL=https://integration.coze.cn
COZE_INTEGRATION_MODEL_BASE_URL=https://integration.coze.cn/api/v3
COZE_WORKLOAD_IDENTITY_API_KEY=在此填入你的API Key

# ====== Supabase 云端模式（可选） ======
# 如需使用 Supabase 云端，取消下面注释并填写，
# 同时注释掉上面的 POSTGREST_URL 配置
# COZE_SUPABASE_URL=https://your-project.supabase.co
# COZE_SUPABASE_ANON_KEY=your-anon-key
# COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
